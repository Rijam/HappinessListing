Mods: {
	HappinessListing: {
		Configs: {
			HappinessListingConfig: {
				DisplayName: Client Options

				Headers: {
					HappinessDialogueOptions: "[c/00FF00:Happiness Dialogue Options]"
					RegularDialogueOptions: "[c/00FF00:Regular Dialogue Options]"
					BestiaryOptions: "[c/00FF00:Bestiary Options]"
				}

				BreakEntriesWithNewLine: {
					Label: "[i:LaserRuler] Break Entries With New Line"
					Tooltip:
						'''
						Each dialogue entry will be placed on a new line.

						Change to "Off" for vanilla behavior.
						Default by mod: "On"
						'''
				}

				EntryIconType: {
					Label: "[hlhi:love]  Entry Icon Type"
					Tooltip:
						'''
						Each dialogue entry will be preceded with a character or icon.

						Change to "None" for vanilla behavior.
						Default by mod: "Happiness Icons"
						'''
				}

				MaxTextLines: {
					Label: "[i:ThePlan] Maximum Text Lines"
					# 	TML145
					# 	'''
					#	Increases or decreases the number of lines the dialogue can be on.
					#	Anything line beyond the value set will be cut off.
					#	Vanilla defaults to 10.
					#
					#	Range: 1-50
					#	Change to 10 for vanilla behavior.
					#	Default by mod: 20
					#	'''
					Tooltip:
						'''
						Increases or decreases the number of lines the dialogue can be on.
						Anything line beyond the value set will be cut off.
						Vanilla defaults to 10.

						Range: 1-20
						Change to 10 for vanilla behavior.
						Default by mod: 16
						'''
				}

				ColorCodeHappinessText: {
					Label: "[i:RedPaint] Color Code Happiness Dialogue"
					Tooltip:
						'''
						Colors each happiness dialogue entry.

						Change to "None" for vanilla behavior.
						Default by mod: "In-game Colors"
						'''
				}

				MaxNumberOfPeoplePrincessCanTalkAboutAtOnce: {
					Label: "[i:PrincessWeapon] Princess Dialogue Maximum"
					Tooltip:
						'''
						Increases or decreases the number of Town NPCs the Princess can talk about at once.
						In vanilla, the Princess will only talk about three random nearby Town NPCs
						  each time the happiness button is clicked.

						Range: 1-20
						Change to 3 for vanilla behavior.
						Default by mod: 5
						'''
				}

				SimplifiedHappinessDialogue: {
					Label: "[i:NecromanticScroll] Simplified Happiness Dialogue"
					Tooltip:
						'''
						Replaces all happiness dialogue with simple, generic dialogue.
						  For example: "I love {NPC}." "I dislike {Biome}." "I dislike how crowded I am."

						Change to Off for vanilla behavior.
						Default by mod: Off
						'''
				}

				ColorCodeRegularDialogue: {
					Label: "[i:BluePaint] Color Code Regular Dialogue"
					Tooltip:
						'''
						Colors each regular dialogue entry.

						Change to "None" for vanilla behavior.
						Default by mod: "None"
						'''
				}

				BestiaryFlavorTextEntry: {
					Label: "[i:DontHurtNatureBook] Bestiary Happiness Info Box"
					Tooltip:
						'''
						Adds an addition info box in the Town NPCs' Bestiary entry with the happiness preferences.
						  Not shown in the info box:
						  * All Town NPCs like the Princess.
						  * All Town NPCs hate the Corruption, Crimson, and Dungeon.

						Change to "None" for vanilla behavior.
						Default by mod: Happiness Icons

						Reload is required to re-initialize the Bestiary. Change this setting from the main menu.
						'''
				}
			}

			IconType: {
				Tooltip: ""

				None: {
					Label: None
					Tooltip:
						'''
						{$Label}

						No characters or icons will precede each dialogue entry.
						Set to this for vanilla behavior or to turn this feature off.
						'''
				}

				Asterick: {
					Label: Asterick
					Tooltip:
						'''
						{$Label}

						Dialogue entries will be preceded with an *
						'''
				}

				Bullet: {
					Label: Bullet
					Tooltip:
						'''
						{$Label}

						Dialogue entries will be preceded with a •
						'''
				}

				Emoticons: {
					Label: Emoticons
					Tooltip:
						'''
						{$Label}

						Dialogue entries will be preceded with emoticons that reflect the preference of the entry:
						  {$UI.HappinessWords.Love}    :D
						  {$UI.HappinessWords.Like}    :)
						  {$UI.HappinessWords.Dislike} :(
						  {$UI.HappinessWords.Hate}    :'(
						'''
				}

				HappinessIcon: {
					Label: Happiness Icons
					Tooltip:
						'''
						{$Label}

						Dialogue entries will be preceded with icons that reflect the preference of the entry:
						  {$UI.HappinessWords.Love}    [hlhi:love]
						  {$UI.HappinessWords.Like}    [hlhi:like]
						  {$UI.HappinessWords.Dislike} [hlhi:disl]
						  {$UI.HappinessWords.Hate}    [hlhi:hate]
						'''
				}

				RightArrow: {
					Label: Right Arrow
					Tooltip:
						'''
						{$Label}

						Dialogue entries will be preceded with a →
						'''
				}

				GreaterThan: {
